# --- Data layer ---------------------------------------------------------
# Leave unset to run on the in-memory demo dataset (fictional data).
# DATABASE_URL=postgres://permitpath:permitpath@localhost:5432/permitpath

# --- AWS ----------------------------------------------------------------
AWS_REGION=us-east-1
# S3 bucket for supporting documents (SSE-KMS, versioned, private).
# PERMITPATH_DOCS_BUCKET=permitpath-documents-dev

# Amazon Bedrock (Claude via the Bedrock Mantle Messages endpoint).
# Leave unset to use deterministic, non-LLM fallbacks for every AI feature.
# BEDROCK_ENABLED=true
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# --- HubSpot ------------------------------------------------------------
# Private app token with crm.objects.contacts.write / companies.write / deals.write.
# Leave unset: demo requests are stored locally and nothing is sent.
# HUBSPOT_PRIVATE_APP_TOKEN=
