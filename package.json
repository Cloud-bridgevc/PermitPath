{
  "name": "permitpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "opennextjs-cloudflare build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:seed-sql": "node --experimental-strip-types scripts/generate-seed-sql.ts > db/seed.sql",
    "build:next": "next build",
    "deploy": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "pg-cloudflare": "^1.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.2"
  }
}
